MEETUP_GROUP_URLNAME=nhdnug
MEETUP_MODE=organizer
MEETUP_ALLOW_PUBLISH=false
MEETUP_ALLOW_DESTRUCTIVE=false
MEETUP_USE_FAKE_API=true

# Real Meetup API settings (required when MEETUP_USE_FAKE_API=false)
# MEETUP_OAUTH_KEY=your-oauth-consumer-key
# MEETUP_OAUTH_SECRET=your-oauth-consumer-secret
# MEETUP_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/meetup/oauth/callback
# MEETUP_TOKEN_STORE_PATH=~/.meetup-mcp/tokens.json
