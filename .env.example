MEETUP_GROUP_URLNAME=your-group-urlname
MEETUP_MODE=organizer
MEETUP_ALLOW_PUBLISH=false
MEETUP_ALLOW_DESTRUCTIVE=false
MEETUP_USE_FAKE_API=false

# OAuth credentials from https://www.meetup.com/api/oauth/create/
MEETUP_OAUTH_KEY=your-consumer-key
MEETUP_OAUTH_SECRET=your-consumer-secret

# Optional overrides
# MEETUP_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/meetup/oauth/callback
# MEETUP_TOKEN_STORE_PATH=~/.meetup-mcp/tokens.json
# MEETUP_API_URL=https://api.meetup.com/gql-ext
# MEETUP_OAUTH_ACCESS_URL=https://secure.meetup.com/oauth2/access
